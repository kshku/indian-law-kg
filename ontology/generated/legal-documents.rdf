  <rdf:Description rdf:about="https://example.org/legal-ontology#consumer-protection-act-2019_Section2_Reference20">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#consumer-protection-act-2019_Section2_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 53</legal:referenceText>
