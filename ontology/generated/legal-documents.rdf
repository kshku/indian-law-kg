  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptAbuseOfDominantPosition">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>abuse of dominant position</rdfs:label>
    <skos:altLabel>abuse of dominance</skos:altLabel>
    <skos:altLabel>abuse of dominant position</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptDominantPosition"/>
    <skos:definition>Anti-competitive conduct by an enterprise that holds a dominant position in a market.</skos:definition>
    <skos:prefLabel>abuse of dominant position</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptAcquisition">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>acquisition</rdfs:label>
    <skos:altLabel>acquisition</skos:altLabel>
    <skos:altLabel>acquisitions</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>The purchase or taking of control over the whole or part of another enterprise.</skos:definition>
    <skos:prefLabel>acquisition</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptAdjudicatingOfficer">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>adjudicating officer</rdfs:label>
    <skos:altLabel>adjudicating officer</skos:altLabel>
    <skos:altLabel>adjudicating officers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>An officer empowered to adjudicate specified contraventions and impose penalties.</skos:definition>
    <skos:prefLabel>adjudicating officer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptAgreement">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>agreement</rdfs:label>
    <skos:altLabel>agreement</skos:altLabel>
    <skos:altLabel>agreements</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>An arrangement or understanding between enterprises, whether formal or informal.</skos:definition>
    <skos:prefLabel>agreement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptAppeal">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>appeal</rdfs:label>
    <skos:altLabel>appeal</skos:altLabel>
    <skos:altLabel>appeals</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A request to a higher authority or court to review a decision.</skos:definition>
    <skos:prefLabel>appeal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptBaggage">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>baggage</rdfs:label>
    <skos:altLabel>baggage</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptRailways"/>
    <skos:definition>Personal belongings carried by a passenger during travel.</skos:definition>
    <skos:prefLabel>baggage</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptCarrier">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>carrier</rdfs:label>
    <skos:altLabel>carrier</skos:altLabel>
    <skos:altLabel>carriers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptTransport"/>
    <skos:definition>A person or entity that undertakes to transport goods or passengers.</skos:definition>
    <skos:prefLabel>carrier</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptCartel">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>cartel</rdfs:label>
    <skos:altLabel>cartel</skos:altLabel>
    <skos:altLabel>cartels</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>An association of producers, sellers, or service providers that limits competition through coordinated conduct.</skos:definition>
    <skos:prefLabel>cartel</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptCertification">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>certification</rdfs:label>
    <skos:altLabel>certification</skos:altLabel>
    <skos:altLabel>certifications</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptStandardisation"/>
    <skos:definition>Formal confirmation that a product, process, or service meets specified standards.</skos:definition>
    <skos:prefLabel>certification</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptCompensation">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>compensation</rdfs:label>
    <skos:altLabel>compensation</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>Payment or other redress for loss, injury, or damage.</skos:definition>
    <skos:prefLabel>compensation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptCompetitionLaw">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>competition law</rdfs:label>
    <skos:altLabel>competition law</skos:altLabel>
    <skos:definition>Legal rules that promote and sustain competition in markets and prohibit anti-competitive conduct.</skos:definition>
    <skos:prefLabel>competition law</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptConsumer">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>consumer</rdfs:label>
    <skos:altLabel>consumer</skos:altLabel>
    <skos:altLabel>consumers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A person who buys goods or hires services for consideration and personal use.</skos:definition>
    <skos:prefLabel>consumer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptConsumerComplaint">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>consumer complaint</rdfs:label>
    <skos:altLabel>complaint</skos:altLabel>
    <skos:altLabel>complaints</skos:altLabel>
    <skos:altLabel>consumer complaint</skos:altLabel>
    <skos:altLabel>consumer complaints</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A formal allegation by a consumer about goods, services, or a trader's conduct.</skos:definition>
    <skos:prefLabel>consumer complaint</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptConsumerDispute">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>consumer dispute</rdfs:label>
    <skos:altLabel>consumer dispute</skos:altLabel>
    <skos:altLabel>consumer disputes</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A dispute between a consumer and a trader, manufacturer, or service provider about goods or services.</skos:definition>
    <skos:prefLabel>consumer dispute</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptConsumerProtection">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>consumer protection</rdfs:label>
    <skos:altLabel>consumer protection</skos:altLabel>
    <skos:definition>Legal rules that protect buyers of goods and recipients of services from unfair or unsafe practices.</skos:definition>
    <skos:prefLabel>consumer protection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptDefect">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>defect</rdfs:label>
    <skos:altLabel>defect</skos:altLabel>
    <skos:altLabel>defective</skos:altLabel>
    <skos:altLabel>defects</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A fault, imperfection, or shortcoming in goods or a product.</skos:definition>
    <skos:prefLabel>defect</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptDeficiency">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>deficiency</rdfs:label>
    <skos:altLabel>deficiencies</skos:altLabel>
    <skos:altLabel>deficiency</skos:altLabel>
    <skos:altLabel>deficient</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A shortcoming or inadequacy in the quality, nature, or manner of performance of a service.</skos:definition>
    <skos:prefLabel>deficiency</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptDirectorGeneral">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>Director General</rdfs:label>
    <skos:altLabel>Director General</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A statutory officer with investigation or enforcement responsibilities under an Act.</skos:definition>
    <skos:prefLabel>Director General</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptDisputeResolution">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>dispute resolution</rdfs:label>
    <skos:altLabel>dispute resolution</skos:altLabel>
    <skos:definition>Processes for resolving disagreements outside ordinary litigation.</skos:definition>
    <skos:prefLabel>dispute resolution</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptDominantPosition">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>dominant position</rdfs:label>
    <skos:altLabel>dominant position</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>A position of strength that lets an enterprise operate independently of competitive forces or affect competitors and consumers.</skos:definition>
    <skos:prefLabel>dominant position</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptECommerce">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>e-commerce</rdfs:label>
    <skos:altLabel>e-commerce</skos:altLabel>
    <skos:altLabel>electronic commerce</skos:altLabel>
    <skos:altLabel>electronic service provider</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>Buying or selling goods or services through electronic or digital networks.</skos:definition>
    <skos:prefLabel>e-commerce</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptEnforcement">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>enforcement</rdfs:label>
    <skos:altLabel>enforcement</skos:altLabel>
    <skos:definition>The process of implementing, monitoring, and securing compliance with legal requirements.</skos:definition>
    <skos:prefLabel>enforcement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptEnterprise">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>enterprise</rdfs:label>
    <skos:altLabel>enterprise</skos:altLabel>
    <skos:altLabel>enterprises</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>A person or body engaged in the production, distribution, or provision of goods or services.</skos:definition>
    <skos:prefLabel>enterprise</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptFoodBusiness">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>food business</rdfs:label>
    <skos:altLabel>food business</skos:altLabel>
    <skos:altLabel>food business operator</skos:altLabel>
    <skos:altLabel>food businesses</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptFoodSafety"/>
    <skos:definition>An undertaking involved in the manufacture, processing, storage, distribution, or sale of food.</skos:definition>
    <skos:prefLabel>food business</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptFoodSafety">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>food safety</rdfs:label>
    <skos:altLabel>food safety</skos:altLabel>
    <skos:definition>Legal requirements and controls that ensure food is safe and fit for human consumption.</skos:definition>
    <skos:prefLabel>food safety</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptHallmark">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>hallmark</rdfs:label>
    <skos:altLabel>hallmark</skos:altLabel>
    <skos:altLabel>hallmarking</skos:altLabel>
    <skos:altLabel>hallmarks</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptStandardisation"/>
    <skos:definition>An official mark confirming that an article meets a prescribed standard, especially for precious metals.</skos:definition>
    <skos:prefLabel>hallmark</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptInspection">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>inspection</rdfs:label>
    <skos:altLabel>inspection</skos:altLabel>
    <skos:altLabel>inspections</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>Official examination of premises, goods, records, or processes to check compliance.</skos:definition>
    <skos:prefLabel>inspection</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptInsurance">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>insurance</rdfs:label>
    <skos:altLabel>insurance</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptTransport"/>
    <skos:definition>A contract under which an insurer agrees to indemnify the insured against specified losses.</skos:definition>
    <skos:prefLabel>insurance</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptLegalMetrology">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>legal metrology</rdfs:label>
    <skos:altLabel>legal metrology</skos:altLabel>
    <skos:definition>Legal control of weights, measures, and measuring instruments used in trade and commerce.</skos:definition>
    <skos:prefLabel>legal metrology</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptLicence">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>licence</rdfs:label>
    <skos:altLabel>licence</skos:altLabel>
    <skos:altLabel>licences</skos:altLabel>
    <skos:altLabel>license</skos:altLabel>
    <skos:altLabel>licenses</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A formal permission granted to carry on an activity subject to legal conditions.</skos:definition>
    <skos:prefLabel>licence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptManufacturer">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>manufacturer</rdfs:label>
    <skos:altLabel>manufacturer</skos:altLabel>
    <skos:altLabel>manufacturers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A person or entity that makes or produces goods.</skos:definition>
    <skos:prefLabel>manufacturer</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptMediation">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>mediation</rdfs:label>
    <skos:altLabel>mediation</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptDisputeResolution"/>
    <skos:definition>A voluntary process in which a mediator helps parties reach a settlement.</skos:definition>
    <skos:prefLabel>mediation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptMediator">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>mediator</rdfs:label>
    <skos:altLabel>mediator</skos:altLabel>
    <skos:altLabel>mediators</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptMediation"/>
    <skos:definition>A neutral person who facilitates communication and settlement in mediation.</skos:definition>
    <skos:prefLabel>mediator</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptMerger">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>merger</rdfs:label>
    <skos:altLabel>merger</skos:altLabel>
    <skos:altLabel>mergers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>The combination of two or more enterprises into one entity or group.</skos:definition>
    <skos:prefLabel>merger</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptMisleadingAdvertisement">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>misleading advertisement</rdfs:label>
    <skos:altLabel>misleading advertisement</skos:altLabel>
    <skos:altLabel>misleading advertisements</skos:altLabel>
    <skos:altLabel>misleading advertising</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>An advertisement that falsely describes a product or service or creates a misleading impression.</skos:definition>
    <skos:prefLabel>misleading advertisement</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptMultimodalTransport">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>multimodal transport</rdfs:label>
    <skos:altLabel>multimodal transport</skos:altLabel>
    <skos:altLabel>multimodal transportation</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptTransport"/>
    <skos:definition>Carriage of goods under a single contract using more than one mode of transport.</skos:definition>
    <skos:prefLabel>multimodal transport</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptOffence">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>offence</rdfs:label>
    <skos:altLabel>offence</skos:altLabel>
    <skos:altLabel>offences</skos:altLabel>
    <skos:altLabel>offense</skos:altLabel>
    <skos:altLabel>offenses</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A violation of law that may lead to prosecution or other legal consequences.</skos:definition>
    <skos:prefLabel>offence</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptPassenger">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>passenger</rdfs:label>
    <skos:altLabel>passenger</skos:altLabel>
    <skos:altLabel>passengers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptRailways"/>
    <skos:definition>A person travelling or intending to travel by railway or another mode of transport.</skos:definition>
    <skos:prefLabel>passenger</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptPenalty">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>penalty</rdfs:label>
    <skos:altLabel>penalties</skos:altLabel>
    <skos:altLabel>penalty</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A financial or other sanction imposed for a breach of legal requirements.</skos:definition>
    <skos:prefLabel>penalty</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptProduct">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>product</rdfs:label>
    <skos:altLabel>product</skos:altLabel>
    <skos:altLabel>products</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>An article or substance manufactured, produced, or offered for sale.</skos:definition>
    <skos:prefLabel>product</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptProductLiability">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>product liability</rdfs:label>
    <skos:altLabel>product liabilities</skos:altLabel>
    <skos:altLabel>product liability</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
