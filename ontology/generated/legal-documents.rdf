    <skos:prefLabel>standard</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptStandardisation">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>standardisation</rdfs:label>
    <skos:altLabel>standardisation</skos:altLabel>
    <skos:altLabel>standardization</skos:altLabel>
    <skos:definition>The process of establishing and applying standards for products, processes, and services.</skos:definition>
    <skos:prefLabel>standardisation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptTransport">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>transport</rdfs:label>
    <skos:altLabel>transport</skos:altLabel>
    <skos:altLabel>transportation</skos:altLabel>
    <skos:definition>The movement of goods or persons from one place to another.</skos:definition>
    <skos:prefLabel>transport</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptTribunal">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>Tribunal</rdfs:label>
    <skos:altLabel>appellate tribunal</skos:altLabel>
    <skos:altLabel>tribunal</skos:altLabel>
    <skos:altLabel>tribunals</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>A body established to adjudicate specified disputes or appeals.</skos:definition>
    <skos:prefLabel>Tribunal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptUnfairTradePractice">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>unfair trade practice</rdfs:label>
    <skos:altLabel>unfair trade practice</skos:altLabel>
    <skos:altLabel>unfair trade practices</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A trade practice that adopts unfair or deceptive methods to promote goods or services.</skos:definition>
    <skos:prefLabel>unfair trade practice</skos:prefLabel>
  </rdf:Description>
