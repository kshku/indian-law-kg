    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">58</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amendment of Act 9 of 1872</legal:sectionTitle>
  </rdf:Description>
