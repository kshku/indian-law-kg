    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section48C_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 48A</legal:referenceText>
