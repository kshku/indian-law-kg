    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section90"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section92">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section92_Passage1"/>
    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">92</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power to make rules in respect of matters in this Chapter</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section92_Passage1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#TextPassage"/>
    <legal:mentionsConcept rdf:resource="https://example.org/legal-ontology#ConceptRailways"/>
    <legal:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</legal:pageNumber>
    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">92. Power to make rules in respect of matters in this Chapter.—(1) The Central Government may,
by notification, make rules to carry out the purposes of this Chapter.
(2) In particular, and without prejudice to the generality of the foregoing power, such rules may provide
for all or any of the following matters, namely:—
(a) the factors to which the Central Government shall have regard under clause (e) of the first
proviso to sub-section (1) of section 89;
(b) the form and manner in which an application may be made under sub-section (2) of
section 89;
(c) the form in which a statement is required to be exhibited under sub-section (3) of section 89;
(d) the manner in which the dates of public auctions may be notified under sub-section (1) of
section 90;
(e) the manner of crediting to the railway administration the price of goods referred to in
sub-clause (iii) of clause (a) of the proviso to sub-section (3) of section 90.</legal:text>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section92_Reference1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
