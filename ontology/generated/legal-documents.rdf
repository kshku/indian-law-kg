    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sections 13 and 14</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#legal-metrology-act-2009_Section13"/>
