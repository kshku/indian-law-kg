  <rdf:Description rdf:about="https://example.org/legal-ontology#mediation-act-2023_Section51_Reference3">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#mediation-act-2023_Section51_Passage1"/>
