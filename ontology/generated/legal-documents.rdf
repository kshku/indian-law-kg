    <skos:prefLabel>service</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptStandard">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>standard</rdfs:label>
    <skos:altLabel>standard</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptStandardisation"/>
