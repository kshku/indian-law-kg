  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#bureau-of-indian-standards-act-2016_Section34_Reference3">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
