    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptCompetitionLaw"/>
    <skos:definition>A trade practice that prevents, distorts, or restricts competition.</skos:definition>
    <skos:prefLabel>restrictive trade practice</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptSearchAndSeizure">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>search and seizure</rdfs:label>
    <skos:altLabel>search and seizure</skos:altLabel>
    <skos:altLabel>search and seizure operations</skos:altLabel>
    <skos:altLabel>search or seizure</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptEnforcement"/>
    <skos:definition>The legal power to search premises or things and take possession of evidence or contraband.</skos:definition>
    <skos:prefLabel>search and seizure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptSeller">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>seller</rdfs:label>
    <skos:altLabel>seller</skos:altLabel>
    <skos:altLabel>sellers</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>A person or entity that sells or offers goods for sale.</skos:definition>
    <skos:prefLabel>seller</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptService">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>service</rdfs:label>
    <skos:altLabel>service</skos:altLabel>
    <skos:altLabel>services</skos:altLabel>
    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
