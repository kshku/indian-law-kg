    <skos:broader rdf:resource="https://example.org/legal-ontology#ConceptConsumerProtection"/>
    <skos:definition>The return of money paid for goods or services.</skos:definition>
    <skos:prefLabel>refund</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptRestrictiveTradePractice">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
