    <skos:prefLabel>product liability</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptPunishment">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>punishment</rdfs:label>
    <skos:altLabel>punishment</skos:altLabel>
