  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section20_Reference6">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section20_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 21</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section21"/>
