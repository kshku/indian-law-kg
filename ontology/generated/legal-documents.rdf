  <rdf:Description rdf:about="https://example.org/legal-ontology#mediation-act-2023_Section4">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#mediation-act-2023_Section4_Passage1"/>
