    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section16"/>
    <legal:resolutionStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resolved</legal:resolutionStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section18">
