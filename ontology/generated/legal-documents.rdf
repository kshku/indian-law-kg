  <rdf:Description rdf:about="https://example.org/legal-ontology#railways-act-1989_Section86_Reference6">
    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section86_Passage1"/>
