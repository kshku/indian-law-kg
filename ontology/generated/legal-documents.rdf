  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section33">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section33_Passage1"/>
    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">33</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power to issue interim orders</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section33_Passage1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#TextPassage"/>
    <legal:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</legal:pageNumber>
    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3[33. Power to issue interim orders.—Where during an inquiry, the Commission is satisfied that an
act in contravention of sub-section (1) of section 3 or sub-section (1) of section 4 or section 6 has been
committed and continues to be committed or that such act is about to be committed, the Commission may,
by order, temporarily restrain any party from carrying on such act until the conclusion of such inquiry or
until further orders, without giving notice to such party, where it deems it necessary.]</legal:text>
  </rdf:Description>
