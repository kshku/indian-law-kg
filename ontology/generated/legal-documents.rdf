  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section48C">
    <rdf:type rdf:resource="https://example.org/legal-ontology#Provision"/>
    <legal:containsPassage rdf:resource="https://example.org/legal-ontology#competition-act-2002_Section48C_Passage1"/>
    <legal:sectionNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#string">48C</legal:sectionNumber>
    <legal:sectionTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Revocation of the settlement or commitment order and penalty</legal:sectionTitle>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#competition-act-2002_Section48C_Passage1">
    <rdf:type rdf:resource="https://example.org/legal-ontology#TextPassage"/>
    <legal:mentionsConcept rdf:resource="https://example.org/legal-ontology#ConceptEnterprise"/>
    <legal:mentionsConcept rdf:resource="https://example.org/legal-ontology#ConceptPenalty"/>
    <legal:pageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</legal:pageNumber>
    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">48C. Revocation of the settlement or commitment order and penalty.—If an applicant fails to
comply with the order passed under section 48A or section 48B or it comes to the notice of the
Commission that the applicant has not made full and true disclosure or there has been a material change in
the facts, the order passed under section 48A or section 48B, as the case may be, shall stand revoked and
withdrawn and such enterprise shall be liable to pay legal costs incurred by the Commission which may
extend to rupees one crore and the Commission may restore or initiate the inquiry in respect of which the
order under section 48A or section 48B was passed.]</legal:text>
  </rdf:Description>
