    <skos:altLabel>railways</skos:altLabel>
    <skos:definition>The railway system, including railway administration, trains, tracks, and related services.</skos:definition>
    <skos:prefLabel>railway</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/legal-ontology#ConceptRefund">
    <rdf:type rdf:resource="https://example.org/legal-ontology#LegalConcept"/>
    <rdfs:label>refund</rdfs:label>
    <skos:altLabel>refund</skos:altLabel>
    <skos:altLabel>refunds</skos:altLabel>
