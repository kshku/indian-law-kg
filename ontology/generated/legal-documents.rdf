    <rdf:type rdf:resource="https://example.org/legal-ontology#ReferenceMention"/>
    <legal:occursIn rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section138_Passage1"/>
    <legal:referenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">section 137</legal:referenceText>
    <legal:referencesProvision rdf:resource="https://example.org/legal-ontology#railways-act-1989_Section137"/>
