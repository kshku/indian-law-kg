    <legal:text rdf:datatype="http://www.w3.org/2001/XMLSchema#string">63.Amendment of 18 of 2013.—The Companies Act, 2013, shall be amended in the manner specified
in the Eighth Schedule.</legal:text>
  </rdf:Description>
